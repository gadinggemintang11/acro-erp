<script>
$(document).ready(function() {
    // Initialize Select2
    $('.select2-supplier').select2({
        placeholder: '-- Pilih Supplier --',
        allowClear: true,
        width: '100%'
    });
    
    // Check field requirement on page load
    updateFieldRequirement();
});

function updateFieldRequirement() {
    const woType = $('select[name="wo_type"]').val();
    const supplierField = $('#supplierField');
    const partnerField = $('#partnerField');
    
    supplierField.hide().find('select').prop('required', false);
    partnerField.hide().find('input').prop('required', false);
    
    if (woType === 'OUT_WH_RETUR') {
        supplierField.show().find('select').prop('required', true);
    } else if (woType === 'OUT_WH_SALES' || woType === 'OUT_WH_SAMPLE') {
        partnerField.show().find('input').prop('required', true);
    }
}
</script>
<script>
$(document).ready(function() {
    $('.select2').select2({
        width: '100%'
    });
});
</script>
