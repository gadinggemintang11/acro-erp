<script>
function handleTypeChange() {
    const woType = document.getElementById('woType').value;
    const grnSection = document.getElementById('grnSection');
    const partnerSection = document.getElementById('partnerSection');
    
    // Reset sections
    grnSection.style.display = 'none';
    partnerSection.style.display = 'none';
    
    if (woType === 'WH_RETUR') {
        grnSection.style.display = 'block';
        // Make GRN required for retur
        document.getElementById('grnSelect').setAttribute('required', 'required');
    } else if (woType === 'WH_SALES' || woType === 'WH_SAMPLE') {
        partnerSection.style.display = 'block';
        // Make partner name required
        document.querySelector('input[name="partner_name"]').setAttribute('required', 'required');
    }
}

$(document).ready(function() {
    // Initialize Select2 for GRN
    $('#grnSelect').select2({
        placeholder: '🔍 Ketik untuk mencari GRN...',
        allowClear: true,
        ajax: {
            url: '<?php echo base_url('warehouse_out/ajax_get_grn'); ?>',
            dataType: 'json',
            delay: 250,
            data: function(params) {
                return {
                    search: params.term
                };
            },
            processResults: function(data) {
                return {
                    results: data.map(function(item) {
                        return {
                            id: item.id,
                            text: `${item.grn_number} - ${item.nama_supplier} (${item.grn_date})`,
                            supplier_id: item.supplier_id,
                            supplier_name: item.nama_supplier
                        };
                    })
                };
            }
        }
    });
    
    // Auto-fill supplier when GRN selected
    $('#grnSelect').on('select2:select', function(e) {
        const data = e.params.data;
        document.getElementById('supplierDisplay').value = data.supplier_name;
        document.getElementById('supplierId').value = data.supplier_id;
    });
    
    // Clear supplier when GRN cleared
    $('#grnSelect').on('select2:clear', function() {
        document.getElementById('supplierDisplay').value = '';
        document.getElementById('supplierId').value = '';
    });
});
</script>