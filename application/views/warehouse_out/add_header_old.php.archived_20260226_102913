<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<script>
$(document).ready(function() {
    // Initialize Supplier Select2 with AJAX
    $('#supplierSelect').select2({
        placeholder: '-- Cari Supplier --',
        allowClear: true,
        width: '100%',
        minimumInputLength: 0,
        ajax: {
            url: '<?php echo base_url('warehouse_out/ajax_get_suppliers'); ?>',
            dataType: 'json',
            delay: 250,
            data: function (params) {
                return {
                    search: params.term || ''
                };
            },
            processResults: function (data) {
                return {
                    results: data
                };
            }
        }
    });

    // Initialize GRN Select2 with AJAX
    $('#grnSelect').select2({
        placeholder: '-- Pilih GRN untuk link --',
        allowClear: true,
        width: '100%',
        minimumInputLength: 0,
        ajax: {
            url: '<?php echo base_url('warehouse_out/ajax_get_grn'); ?>',
            dataType: 'json',
            delay: 250,
            data: function (params) {
                return {
                    search: params.term || ''
                };
            },
            processResults: function (data) {
                return {
                    results: data
                };
            }
        }
    });

    // Event: Saat GRN dipilih, auto-fill supplier
    $('#grnSelect').on('change', function() {
        const grn_id = $(this).val();
        const woType = $('#woType').val();
        
        if (!grn_id || woType !== 'OUT_WH_RETUR') {
            return;
        }

        // Call AJAX to get supplier info dari GRN
        $.ajax({
            url: '<?php echo base_url('warehouse_out/ajax_get_grn_supplier/'); ?>' + grn_id,
            type: 'GET',
            dataType: 'json',
            success: function(response) {
                if (response.success && response.supplier_id) {
                    // Set supplier value di Select2
                    $('#supplierSelect').val(response.supplier_id).trigger('change');
                    
                    // Highlight supplier field untuk user
                    $('#supplierSelect').closest('.col-md-12').find('.form-select').focus();
                    
                    console.log('✅ Supplier auto-filled: ' + response.supplier_name);
                }
            },
            error: function(err) {
                console.error('Error fetching GRN supplier:', err);
            }
        });
    });

    // Update field visibility based on WO type
    updateFieldRequirement();
});

function updateFieldRequirement() {
    const woType = $('#woType').val();
    const supplierField = $('#supplierField');
    const partnerField = $('#partnerField');
    
    // Reset both fields
    supplierField.hide().find('select').prop('required', false).val('').trigger('change');
    partnerField.hide().find('input').prop('required', false).val('');
    
    // Show appropriate field based on type
    if (woType === 'OUT_WH_RETUR') {
        supplierField.show().find('select').prop('required', true);
    } else if (woType === 'OUT_WH_SALES' || woType === 'OUT_WH_SAMPLE') {
        partnerField.show().find('input').prop('required', true);
    }
}
</script>
