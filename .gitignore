##################################
# 1. IGNORE SEMUA
##################################
*

##################################
# 2. IZINKAN FOLDER YANG DIPAKAI
##################################
!application/
!assets/
# vendor (Composer) ikut di-commit: server cPanel deploy via git pull tanpa
# Composer. Tanpa baris ini "!vendor/**/*" di bawah tidak berlaku karena
# foldernya sendiri masih ter-ignore (2026-11-07).
!vendor/


##################################
# 3. IZINKAN ISI DI DALAMNYA
##################################
!application/**/*
!assets/**/*
!vendor/**/*

# Migrasi database IKUT repo (2026-11-09): halaman "Migrasi Database"
# (Migration_runner_model) membaca urutan dari db/deploy_migrations.sh,
# file dari db/migration_*.sql, dan deskripsi dari
# docs/PENDING_MIGRATIONS_MASTER.md -- server deploy via git pull, jadi tanpa
# ini migrasi baru tidak pernah sampai ke server. Dump/log di db/ TETAP tidak
# ikut. db/.htaccess & docs/.htaccess memblokir akses web ke folder itu.
!db/
!db/.htaccess
!db/deploy_migrations.sh
!db/migration_*.sql
!docs/
!docs/.htaccess
!docs/PENDING_MIGRATIONS_MASTER.md

##################################
# 4. KHUSUS CODEIGNITER (AMAN)
##################################
application/cache/*
!application/cache/index.html

application/logs/*
!application/logs/index.html

# Cache font dompdf -- dibuat saat runtime di server, jangan di-commit
# (kalau ikut, git pull di server bisa bentrok dengan file yang ditulis dompdf).
vendor/dompdf/dompdf/lib/fonts/installed-fonts.json
vendor/dompdf/dompdf/lib/fonts/*.afm.json
vendor/dompdf/dompdf/lib/fonts/*.ufm.json
vendor/dompdf/dompdf/lib/fonts/*_????????????????????????????????.*

##################################
# 5. FILE ROOT YANG DIPERLUKAN
##################################
!index.php
!composer.json
!composer.lock
!.gitignore

##################################
# 6. OS / IDE / ENV (TETAP DIABAIKAN)
##################################
.env
.DS_Store
__MACOSX/
._*
.idea/
.vscode/
nbproject/

##################################
# 7. TEST / BUILD / ZIP
##################################
tests/
user_guide_src/
apache/logs/
env/
*.zip
